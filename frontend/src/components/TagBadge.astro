---
interface Props {
  tag: string;
  slug?: string;
  color?: string;
  colorDark?: string;
  count?: number;
  size?: 'sm' | 'md';
  linked?: boolean;
}

const { tag, slug: slugProp, color, colorDark, count, size = 'sm', linked = false } = Astro.props;

const slug = slugProp || tag.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');

const fallbackClass = 'bg-[var(--color-bg-surface)] text-[var(--color-text-muted)] border-[var(--color-border)]';

const sizeClass = size === 'md'
  ? 'px-3 py-1.5 text-sm'
  : 'px-2 py-0.5 text-xs';

const Tag = linked ? 'a' : 'span';
---

<Tag
  class:list={[
    'inline-flex items-center gap-1.5 rounded-md border font-mono transition-all duration-200',
    color ? 'tag-colored' : fallbackClass,
    sizeClass,
    linked && 'hover:scale-105',
  ]}
  style={color ? `--tag-c: ${color}; --tag-cd: ${colorDark || color};` : undefined}
  {...linked ? { href: `/tags/${slug}` } : {}}
>
  {tag}
  {count !== undefined && (
    <span class="opacity-60">{count}</span>
  )}
</Tag>

<style>
  .tag-colored {
    background-color: color-mix(in srgb, var(--tag-c) 12%, transparent);
    color: var(--tag-c);
    border-color: color-mix(in srgb, var(--tag-c) 25%, transparent);
  }
  :global(.dark) .tag-colored {
    background-color: color-mix(in srgb, var(--tag-cd) 12%, transparent);
    color: var(--tag-cd);
    border-color: color-mix(in srgb, var(--tag-cd) 25%, transparent);
  }
</style>
