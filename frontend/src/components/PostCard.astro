---
import TagBadge from './TagBadge.astro';
import type { PostTag } from '../data/api';

interface Props {
  slug: string;
  title: string;
  excerpt: string;
  date: string;
  tags: PostTag[];
  readingTime: string;
  featured?: boolean;
}

const { slug, title, excerpt, date, tags, readingTime, featured = false } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article
  class:list={[
    'group relative rounded-xl border border-[var(--color-border)] transition-all duration-300',
    'hover:border-[var(--color-accent)]/40 hover:shadow-lg hover:shadow-[var(--color-accent)]/5',
    featured ? 'p-8 md:p-10' : 'p-6 md:p-8',
  ]}
>
  <!-- Accent top border on hover -->
  <div class="absolute top-0 left-6 right-6 h-px bg-gradient-to-r from-transparent via-[var(--color-accent)] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>

  <a href={`/blog/${slug}`} class="block space-y-4">
    <!-- Meta -->
    <div class="flex items-center gap-3 text-xs font-mono text-[var(--color-text-muted)]">
      <time datetime={date}>{formattedDate}</time>
      <span class="w-1 h-1 rounded-full bg-[var(--color-text-muted)]"></span>
      <span>{readingTime}</span>
      <span class="w-1 h-1 rounded-full bg-[var(--color-text-muted)]"></span>
      <span class="postcard-likes" data-slug={slug}>
        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" />
        </svg>
        <span class="postcard-like-count">—</span>
      </span>
      <span class="w-1 h-1 rounded-full bg-[var(--color-text-muted)]"></span>
      <span class="postcard-comments">
        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
        </svg>
        <span class="postcard-comment-count">—</span>
      </span>
      <span class="w-1 h-1 rounded-full bg-[var(--color-text-muted)]"></span>
      <span class="postcard-views" data-slug={slug}>
        <svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
          <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
          <circle cx="12" cy="12" r="3" />
        </svg>
        <span class="postcard-view-count">—</span>
      </span>
    </div>

    <!-- Title -->
    <h3
      class:list={[
        'font-display font-semibold tracking-tight group-hover:text-[var(--color-accent)] transition-colors duration-200',
        featured ? 'text-display-md' : 'text-display-md text-xl',
      ]}
      transition:name={`post-title-${slug}`}
    >
      {title}
    </h3>

    <!-- Excerpt -->
    <p class="text-body-sm text-[var(--color-text-muted)] text-pretty line-clamp-3">
      {excerpt}
    </p>

    <!-- Tags -->
    <div class="flex flex-wrap gap-2 pt-2">
      {tags.map((tag) => (
        <TagBadge tag={tag.name} color={tag.color} colorDark={tag.colorDark} />
      ))}
    </div>
  </a>
</article>
